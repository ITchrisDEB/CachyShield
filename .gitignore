# Rust / Cargo
/target/
**/*.rs.bk
*.pdb

# Release archives (built by packaging/make-release.sh)
/dist/

# Arch packaging build output (makepkg)
/packaging/src/
/packaging/pkg/
/packaging/*.tar.*
/packaging/*.pkg.tar*
/packaging/*.log

# Editors and IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
.directory

# Local state, secrets and scratch files — never commit these
.env
.env.*
*.local
/scratch/
/tmp/
/.claude/
